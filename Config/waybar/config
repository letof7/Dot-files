{
    "layer": "top",
    "position": "top",
    "height": 15,
    "width": 2530,
    "margin": "3, 0, 2, 0",

    "modules-left": [
    "cpu",
    "custom/separator",
    "memory",
    "custom/separator",
    "disk",
    "disk#2",
    "custom/separator",
    "hyprland/window"
    ],

    "modules-center": [
    "custom/screenshot",
    "tray",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "wlr/taskbar"
    ],

    "modules-right": [
        "network",
        "custom/separator",

    
    "clock",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "custom/power_btn",
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "icon-size": 30,
        "format-icons": {
            "1": "",
            "2": "",
            "3": "󰎇",
            "4": "",
            "5": "",
            "6": "󰮯",
            "7": "󰮯",
            "8": "󰼸",
            "9": "󰮯",
            "urgent": "",
            "focused": "",
            "default": ""
    }


    },

    "custom/screenshot": {
    "format": "󰹑 ",
    "tooltip": "Capture d'écran",
    "on-click": "grim -g \"$(slurp)\" ~/Documents/Imgs/screen-shot/screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png"
    
    },
    "custom/separator": {
	"format": "<span foreground='#ffffff'>  </span>",
        "interval": "once",
        "tooltip": false
    },
    "custom/power_btn": {
	"format": "<span foreground='#ff5555'>  </span>",
        "icon-size": 30,
        "on-click": "sh -c '(sleep 0.5s; wlogout --protocol layer-shell)' & disown",
        "tooltip": false
    },
     "custom/network_traffic": {
             "exec": "~/.config/waybar/scripts/network_traffic.sh enp7s0",
             "return-type": "json",
             "format": "{}",    // optional
    },
    "tray": {
        "icon-size": 20,
        "spacing": 6
    },
    "clock": {
        "interval": 1,
        "locale": "C", 
        "format": "  {:%I:%M %p}",
        "format-alt": " {:%a,%b %d}" // Icon: calendar-alt
    },
    "cpu": { 
"format": "<span foreground='#a6da95'> </span>&#8239; {usage}%",
"tooltip": false, "on-click": 
"kitty -e 'btop'"

    },
    "memory": {
        "interval": 30,
        "format": " {used:0.2f}GB",
        "max-length": 10,
        "tooltip": false,
        "warning": 70,
        "critical": 90
    },
    "disk": {
        "interval": 30,
        "format": " 󰋊-Root {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
    },
     "disk#2": {
        "interval": 30,
        "format": " 󰋊-Stock {percentage_used}%",
        "path": "/home/tof/STOCK1",
        "tooltip": true,
        "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "all-outputs": true,
        "icon-size": 14,
        "icon-theme": "candy-icons",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "app_ids-mapping": {
        "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
        "Firefox Web Browser": "Firefox",
        "Foot Server": "Terminal"
    }
    
    },
 

"network": {
  "interface": "enp7s0",
  "interval": 2,
  "format": "󰈀 {ifname} {ipaddr}",
  "format-ethernet": "󰈀 {ifname} {ipaddr} 󰄺 {bandwidthUpBits}bps | 󰄾 {bandwidthDownBits}bps",
  "format-wifi": " {essid} {ipaddr} 󰄺 {bandwidthUpBits}bps | 󰄾 {bandwidthDownBits}bps",
  "format-disconnected": "󰖪 déconnecté",
  "tooltip-format": "{ifname} via {gwaddr}\n󰆨 IP : {ipaddr}/{cidr}\n󰄺 UP : {bandwidthUpBits}bps\n󰄾 DOWN : {bandwidthDownBits}bps",
  "on-click": "",
  "max-length": 50




},
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
    },
    "keybinds": {
        "438u": "pamixer -i 5",
        "439u": "pamixer -d 5"
        }
    },
    
}
