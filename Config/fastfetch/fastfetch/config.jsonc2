{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/pngs/\" -name \"*.png\" | sort -R | head -1)",
        "height": 13,
        "recache": true
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Tof@archlinux──-"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "dim_white"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "dim_white"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "dim_white"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "dim_white"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "dim_white"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "dim_white"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "dim_white"
        },
        {
            "type": "de",
            "key": " DE",
            "keyColor": "dim_white"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "dim_white"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "dim_white"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "dim_white"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "dim_white"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "dim_white",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "dim_white"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "dim_white"
        },

//        {
//            "type": "colors"
//        },
 
    ]
}
